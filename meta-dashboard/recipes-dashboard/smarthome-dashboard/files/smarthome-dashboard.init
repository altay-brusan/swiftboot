#!/bin/sh
### BEGIN INIT INFO
# Provides:          smarthome-dashboard
# Required-Start:    $local_fs $remote_fs
# Should-Start:      udev
# Required-Stop:     $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Smart Home Dashboard (Qt6 eglfs)
### END INIT INFO

DAEMON=/usr/bin/appSmartDashboard
NAME=appSmartDashboard
PIDFILE=/var/run/smarthome-dashboard.pid
LOGFILE=/var/volatile/log/smarthome-dashboard.log

# The rootfs is mounted read-only, so every path Qt wants to write to has to
# land on a tmpfs. /run is one, so anchor the XDG dirs there. Without a
# writable XDG_RUNTIME_DIR Qt warns and some paths fail outright.
RUNDIR=/run/user/0
export XDG_RUNTIME_DIR="$RUNDIR"
export XDG_CACHE_HOME="$RUNDIR/cache"
export XDG_CONFIG_HOME="$RUNDIR/config"
export HOME=/home/root

# Render straight to KMS/DRM - no X, no compositor. qtbase is built with
# eglfs/gles2/kms/gbm and QT_QPA_DEFAULT_PLATFORM is already eglfs, but set it
# explicitly so this script does not depend on how qtbase was configured.
export QT_QPA_PLATFORM=eglfs
export QT_QPA_EGLFS_INTEGRATION=eglfs_kms
export QT_QPA_EGLFS_ALWAYS_SET_MODE=1
export QT_QPA_EGLFS_HIDECURSOR=1

# udev creates /dev/dri/card0 for the virtio-gpu; starting before it exists
# makes eglfs abort. Wait a bounded amount of time rather than racing it.
wait_for_drm() {
    i=0
    while [ ! -e /dev/dri/card0 ]; do
        i=$((i + 1))
        if [ $i -gt 100 ]; then
            echo "$NAME: /dev/dri/card0 never appeared; starting anyway" >&2
            return 1
        fi
        sleep 0.1 2>/dev/null || sleep 1
    done
    return 0
}

running() {
    [ -f "$PIDFILE" ] || return 1
    read -r pid < "$PIDFILE" 2>/dev/null || return 1
    [ -n "$pid" ] || return 1
    [ -d "/proc/$pid" ] || return 1
    return 0
}

case "$1" in
    start)
        if running; then
            echo "$NAME is already running"
            exit 0
        fi
        echo -n "Starting $NAME: "
        mkdir -p "$RUNDIR" "$XDG_CACHE_HOME" "$XDG_CONFIG_HOME"
        chmod 0700 "$RUNDIR"
        mkdir -p "$(dirname "$LOGFILE")"
        wait_for_drm
        "$DAEMON" >>"$LOGFILE" 2>&1 &
        echo $! > "$PIDFILE"
        echo "OK"
        ;;
    stop)
        echo -n "Stopping $NAME: "
        if running; then
            read -r pid < "$PIDFILE"
            kill "$pid" 2>/dev/null
            i=0
            while [ -d "/proc/$pid" ] && [ $i -lt 50 ]; do
                i=$((i + 1))
                sleep 0.1 2>/dev/null || sleep 1
            done
            [ -d "/proc/$pid" ] && kill -9 "$pid" 2>/dev/null
            echo "OK"
        else
            echo "not running"
        fi
        rm -f "$PIDFILE"
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        if running; then
            read -r pid < "$PIDFILE"
            echo "$NAME is running (pid $pid)"
            exit 0
        fi
        echo "$NAME is not running"
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac

exit 0
